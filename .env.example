# Copy this file to .env for local development. Never commit real keys.
PORT=3000
FRONTEND_ORIGIN=http://localhost:5500,https://your-site.github.io
SUPUN_API_KEY=put_your_new_api_key_here
PROXY_SECRET=replace_with_a_long_random_secret
PROXY_DOWNLOADS=true
DEBUG=false
MAX_RESOLVES_PER_MINUTE=30
# Optional alternative provider base URL:
# DTZ_API_BASE_URL=https://dtz-movie-script.vercel.app

# Optional AI SEO tools (create a key in Google AI Studio; keep it server-side)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_SEO_AI_PER_MINUTE=8
